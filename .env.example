# Copier ce fichier en .env.local et remplir les valeurs (jamais committé).
# Supabase > Project Settings > API Keys / Data API

# Publiques (exposées au navigateur, protégées par la RLS)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Serveur uniquement — NE JAMAIS préfixer par NEXT_PUBLIC_
# Utilisée seulement par les scripts d'administration et les tests (src/lib/supabase/admin.ts)
SUPABASE_SECRET_KEY=sb_secret_...

# URL publique de l'application (liens dans les e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Serveur uniquement — secret de la tâche quotidienne /api/cron (purge de la démo, maintien actif)
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
